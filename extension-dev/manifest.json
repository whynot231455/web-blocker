{
  "name": "Ctrl+Blck DEV",
  "description": "Close all the distractions while browsing.",
  "version": "1.0",
  "manifest_version": 3,
  "icons": {
    "16": "assets/icons/logopic1-dev-16.png",
    "32": "assets/icons/logopic1-dev-32.png",
    "48": "assets/icons/logopic1-dev-48.png",
    "128": "assets/icons/logopic1-dev-128.png"
  },
  "permissions": [
    "alarms",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://laovgvktsxwiieuznnlm.supabase.co/*"
  ],
  "action": {
    "default_icon": {
      "16": "assets/icons/logopic1-dev-16.png",
      "32": "assets/icons/logopic1-dev-32.png",
      "48": "assets/icons/logopic1-dev-48.png",
      "128": "assets/icons/logopic1-dev-128.png"
    },
    "default_title": "Ctrl+Blck DEV",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/config.js",
        "lib/url-utils.js",
        "lib/schedule-utils.js",
        "lib/sync-constants.js",
        "content/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/config.js",
        "lib/url-utils.js",
        "lib/schedule-utils.js",
        "lib/sync-constants.js",
        "content/dashboard-sync.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/fonts/PressStart2P-Regular.ttf",
        "assets/detect.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*"
    ]
  }
}
